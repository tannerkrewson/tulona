{
  "expo": {
    "name": "Tulona",
    "slug": "tulona",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "tulona",
    "primaryColor": "#102033",
    "plugins": ["expo-router", "expo-audio", "expo-document-picker", "expo-asset"],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/tulona"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Tulona",
      "shortName": "Tulona",
      "lang": "en",
      "themeColor": "#102033",
      "backgroundColor": "#F4F1EA",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "./",
      "scope": "./"
    }
  }
}
