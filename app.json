{
  "expo": {
    "name": "Tulona",
    "slug": "tulona",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "tulona",
    "icon": "./assets/app-icons/icon-1024.png",
    "primaryColor": "#111111",
    "ios": {
      "icon": "./assets/app-icons/icon-1024.png",
      "bundleIdentifier": "com.tannerkrewson.tulona",
      "buildNumber": "1",
      "deploymentTarget": "16.4",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icons/android-foreground.png",
        "monochromeImage": "./assets/app-icons/android-monochrome.png",
        "backgroundColor": "#0F0E13"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://www.tannerkrewson.com"
        }
      ],
      "expo-audio",
      "expo-document-picker",
      "expo-asset",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.tannerkrewson.tulona.widgets",
          "groupIdentifier": "group.com.tannerkrewson.tulona",
          "widgets": [
            {
              "name": "ActiveActivityWidget",
              "displayName": "Current activity",
              "description": "See what you are tracking, or your current routine step, with a live timer.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ],
      "./plugins/with-launch-appearance.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Tulona",
      "shortName": "Tulona",
      "lang": "en",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "./",
      "scope": "./"
    }
  }
}
