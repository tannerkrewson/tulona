{
  "expo": {
    "name": "Tulona",
    "slug": "tulona",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "tulona",
    "icon": "./public/icons/icon-512.png",
    "primaryColor": "#111111",
    "ios": {
      "bundleIdentifier": "com.tannerkrewson.tulona",
      "buildNumber": "1",
      "deploymentTarget": "16.4",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": ["expo-router", "expo-audio", "expo-document-picker", "expo-asset"],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "Tulona",
      "shortName": "Tulona",
      "lang": "en",
      "themeColor": "#000000",
      "backgroundColor": "#000000",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "./",
      "scope": "./"
    }
  }
}
