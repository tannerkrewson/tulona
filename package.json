    "expo": "^58.0.0-preview.7",
    "expo-asset": "~58.0.7",
    "expo-audio": "~58.0.2",
    "expo-constants": "~58.0.7",
    "expo-document-picker": "~58.0.1",
    "expo-linking": "~58.0.7",
    "expo-router": "~58.0.8",
    "expo-widgets": "~58.0.7",
    "fflate": "^0.8.3",
    "frimousse": "^0.4.0",
    "idb": "^8.0.3",
    "lucide-react-native": "^1.48.0",
    "luxon": "^3.7.2",
    "react": "19.3.0",
    "react-colorful": "^5.8.1",
