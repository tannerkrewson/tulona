  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~57.0.2",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "6.3.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "workbox-cli": "7.4.1"
  }
}
