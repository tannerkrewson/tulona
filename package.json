{
  "name": "tulona",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test:domain": "tsx tests/domain-calculations.ts",
    "test:theme": "tsx tests/theme-colors.ts",
    "test:persistence": "tsx tests/persistence-checks.ts",
    "test:tracker": "tsx tests/tracker-engine.ts",
    "test:routine": "tsx tests/routine-service.ts",
    "test:integration": "tsx tests/integration-coordinator.ts",
    "web:export": "expo export --platform web --output-dir dist --clear && node scripts/prepare-static-site.cjs",
    "pwa:generate": "workbox generateSW workbox.config.cjs",
    "pwa:validate": "node scripts/validate-pwa-build.cjs",
    "web:build": "npm run web:export && npm run pwa:generate && npm run pwa:validate",
    "deploy": "npm run web:build && gh-pages --dist dist --nojekyll"
  },
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "frimousse": "^0.3.0",
    "lucide-react-native": "1.37.0",
    "react": "19.2.3",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~57.0.2",
    "gh-pages": "6.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "workbox-cli": "7.4.1"
  }
}
