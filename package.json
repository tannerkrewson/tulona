    "test:history-month": "tsx tests/history-month-regressions.ts",
    "test:history-year": "tsx tests/history-year-regressions.ts",
    "test:history-session": "tsx tests/history-session-editing.ts",
    "test:goals": "tsx tests/goals.ts",
    "test:goals-ui": "tsx tests/goals-ui-regressions.ts",
    "test:goal-review-navigation": "tsx tests/goal-review-navigation.ts",
    "test:reporting-backup": "tsx tests/reporting-backup.ts",
    "test:timemator-import": "tsx tests/timemator-import.ts",
