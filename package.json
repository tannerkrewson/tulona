{
  "name": "tulona",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test:domain": "tsx tests/domain-calculations.ts",
    "test:history-domain": "tsx tests/history-domain.ts",
    "test:history-day": "tsx tests/history-day-regressions.ts",
    "test:history-week": "tsx tests/history-week-regressions.ts",
    "test:history-month": "tsx tests/history-month-regressions.ts",
    "test:history-year": "tsx tests/history-year-regressions.ts",
    "test:history-session": "tsx tests/history-session-editing.ts",
    "test:catalog-editor": "tsx tests/catalog-editor-regressions.ts",
    "test:history-analytics": "tsx tests/history-analytics.ts",
    "test:habits": "tsx tests/habits.ts",
    "test:habit-ui": "tsx tests/habit-ui-regressions.ts",
    "test:theme": "tsx tests/theme-colors.ts",
    "test:history-ui": "tsx tests/history-ui-regressions.ts",
    "test:history-navigation": "tsx tests/history-navigation.ts",
    "test:card-geometry": "tsx tests/card-geometry.ts",
    "test:pwa-ui": "tsx tests/pwa-ui-regressions.ts",
    "test:settings-ui": "tsx tests/settings-ui-regressions.ts",
    "test:active-session": "tsx tests/active-session-regressions.ts",
    "test:persistence": "tsx tests/persistence-checks.ts",
    "test:tracker": "tsx tests/tracker-engine.ts",
    "test:tracker-ui": "tsx tests/tracker-ui-regressions.ts",
    "test:routine": "tsx tests/routine-service.ts",
    "test:routine-ui": "tsx tests/routine-ui-regressions.ts",
    "test:integration": "tsx tests/integration-coordinator.ts",
    "test:icons": "tsx tests/icon-values.ts",
    "web:export": "expo export --platform web --output-dir dist --clear && node scripts/prepare-static-site.cjs",
    "pwa:generate": "workbox generateSW workbox.config.cjs",
    "pwa:validate": "node scripts/validate-pwa-build.cjs",
    "web:build": "npm run web:export && npm run pwa:generate && npm run pwa:validate",
    "deploy": "npm run web:build && gh-pages --dist dist --nojekyll"
  },
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "frimousse": "^0.3.0",
    "lucide-react-native": "1.37.0",
    "react": "19.2.3",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "victory-native": "^42.0.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~57.0.2",
    "gh-pages": "6.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "workbox-cli": "7.4.1"
  }
}
