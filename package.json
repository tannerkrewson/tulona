    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.13.0",
    "victory-native": "^42.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@types/luxon": "^3.7.5",
    "@types/react": "~19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-expo": "~58.0.2",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "6.3.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "workbox-cli": "7.4.1"
  },
  "expo": {
    "autolinking": {
      "apple": {
        "exclude": [
          "expo-widgets"
        ]
      }
    }
  }
