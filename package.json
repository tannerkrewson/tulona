{
  "name": "tulona",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "TULONA_WEB_BUILD=1 expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test:widget": "tsx tests/active-activity-widget.ts",
    "test:domain": "tsx tests/domain-calculations.ts",
    "test:history-domain": "tsx tests/history-domain.ts",
    "test:history-day": "tsx tests/history-day-regressions.ts",
    "test:history-week": "tsx tests/history-week-regressions.ts",
    "test:history-month": "tsx tests/history-month-regressions.ts",
    "test:history-year": "tsx tests/history-year-regressions.ts",
    "test:history-session": "tsx tests/history-session-editing.ts",
    "test:goals": "tsx tests/goals.ts",
    "test:goals-ui": "tsx tests/goals-ui-regressions.ts",
    "test:goal-review-navigation": "tsx tests/goal-review-navigation.ts",
    "test:reporting-backup": "tsx tests/reporting-backup.ts",
    "test:timemator-import": "tsx tests/timemator-import.ts",
    "test:goal-settings": "tsx tests/goal-settings.ts",
    "test:goal-settings-ui": "tsx tests/goal-settings-ui-regressions.ts",
    "test:goal-evaluation": "tsx tests/goal-evaluation.ts",
    "test:color-palette": "tsx tests/color-palette.ts",
    "test:history-analytics": "tsx tests/history-analytics.ts",
    "test:habits": "tsx tests/habits.ts",
    "test:habit-ui": "tsx tests/habit-ui-regressions.ts",
    "test:theme": "tsx tests/theme-colors.ts",
    "test:history-ui": "tsx tests/history-ui-regressions.ts",
    "test:history-navigation": "tsx tests/history-navigation.ts",
    "test:card-geometry": "tsx tests/card-geometry.ts",
    "test:pwa-ui": "tsx tests/pwa-ui-regressions.ts",
    "test:settings-ui": "tsx tests/settings-ui-regressions.ts",
    "test:active-session": "tsx tests/active-session-regressions.ts",
    "test:modal-ui": "tsx tests/modal-ui-regressions.ts",
    "test:indexed-db": "tsx tests/indexed-db-storage.ts",
    "test:database-observer": "tsx tests/database-observer.ts",
    "test:dropbox-backup": "tsx tests/dropbox-backup.ts",
    "test:dropbox-ui": "tsx tests/dropbox-ui-regressions.ts",
    "test:persistence": "tsx tests/persistence-checks.ts",
    "test:tracker": "tsx tests/tracker-engine.ts",
    "test:tracker-ui": "tsx tests/tracker-ui-regressions.ts",
    "test:routine": "tsx tests/routine-service.ts",
    "test:routine-ui": "tsx tests/routine-ui-regressions.ts",
    "test:integration": "tsx tests/integration-coordinator.ts",
    "test:icons": "tsx tests/icon-values.ts",
    "web:export": "TULONA_WEB_BUILD=1 expo export --platform web --output-dir dist --clear && node scripts/prepare-static-site.cjs",
    "pwa:generate": "workbox generateSW workbox.config.cjs",
    "pwa:validate": "node scripts/validate-pwa-build.cjs",
    "web:build": "npm run web:export && npm run pwa:generate && npm run pwa:validate",
    "deploy": "npm run web:build && gh-pages --dist dist --nojekyll"
  },
  "dependencies": {
    "@expo/ui": "~57.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.12.0",
    "dropbox": "10.46.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-widgets": "~57.0.20",
    "frimousse": "^0.3.0",
    "idb": "^8.0.3",
    "lucide-react-native": "1.47.0",
    "react": "19.2.3",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "victory-native": "^42.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
