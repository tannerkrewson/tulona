    "test:history-ui": "tsx tests/history-ui-regressions.ts",
    "test:history-navigation": "tsx tests/history-navigation.ts",
    "test:card-geometry": "tsx tests/card-geometry.ts",
    "test:pwa-ui": "tsx tests/pwa-ui-regressions.ts",
